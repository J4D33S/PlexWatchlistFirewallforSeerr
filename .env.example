# ─────────────────────────────────────────────────────────────────
#  Media Request Firewall — Example Configuration
#  Copy this file to .env and fill in your values.
#  The .env file is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────

# Safety: always start with DRY_RUN=true to preview decisions
DRY_RUN=true

# Seerr connection (required)
SEERR_URL=http://your-seerr-ip:5055
SEERR_API_KEY=your_seerr_api_key_here

# Plex connection (recommended — confirms items are in your library)
# Without this, only Seerr's API status is used for skip decisions
PLEX_URL=http://your-plex-ip:32400
PLEX_TOKEN=your_plex_token_here

# TVDB (optional — used for TV show & anime poster images)
# Get a free key at https://thetvdb.com/api-information
TVDB_API_KEY=your_tvdb_api_key_here
TVDB_PIN=your_tvdb_user_pin_here

# TMDB (optional — used for movie posters & anime detection)
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_read_access_token_here

# Auto-run schedule (hours). 0 = disabled, runs manually only
SCHEDULE_INTERVAL=0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
